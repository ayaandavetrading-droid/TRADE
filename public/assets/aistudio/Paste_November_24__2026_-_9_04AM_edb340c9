const fmtTick=v=>cur()+(Math.abs(v)>=1000?(v/1000).toFixed(v%1000===0?0:1)+'k':v);
function barsSVG(items,target,opts){opts=opts||{};
  const W=640,H=230,L=52,R=target!=null?54:10,T=12,B=26;const vals=items.map(i=>i.v);
