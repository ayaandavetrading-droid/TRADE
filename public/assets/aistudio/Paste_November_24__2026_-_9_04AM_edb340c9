/* ---------- charts ---------- */
function niceTicks(min,max,n){if(max-min<1e-9){max=min+1}const raw=(max-min)/n;const p=Math.pow(10,Math.floor(Math.log10(raw)));const f=raw/p;const nf=f<=1?1:f<=2?2:f<=5?5:10;const step=nf*p;
