  '<div class="grid g-cal"><section class="card"><div class="cal-head"><h2>'+MONTHS[M-1]+' '+Y+'</h2><button class="btn sm" data-act="cal-prev" aria-label="Previous month">'+ic('left')+'</button><button class="btn sm" data-act="cal-today">Today</button><button class="btn sm" data-act="cal-next" aria-label="Next month">'+ic('right')+'</button></div><div class="dow" style="margin-top:10px">'+['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].map(x=>'<span>'+x+'</span>').join('')+'</div><div class="cells">'+cells+'</div><div class="legend" style="margin-top:12px"><span><i style="background:#12b886"></i>Target hit</span><span><i style="background:rgba(18,184,134,.4)"></i>Profit</span><span><i style="background:rgba(232,85,63,.4)"></i>Loss</span><span><i style="box-shadow:0 0 0 2px var(--orange);background:#fff"></i>Today</span></div></section>'+
  '<section class="card"><div class="card-h"><div><h2>'+longDate(calSel)+'</h2><p class="sub">'+(ss.n?ss.n+' trade'+(ss.n>1?'s':'')+' · target '+money(ss.target,{dec:0}):'No trades logged')+'</p></div>'+(ss.n?'<span class="pill '+(ss.net>=ss.target&&ss.target>0?'good':ss.net<0?'bad':'blue')+'">'+money(ss.net,{sign:true})+'</span>':'')+'</div>'+
  (dayTr.length?dayTr.map(t=>'<div class="list-row"><span><b>'+esc(t.symbol)+'</b> <span class="side-tag '+(t.side==='Buy'?'buy':'sell')+'">'+esc(t.side)+'</span> <span class="small">'+esc(t.time||'')+'</span></span><span style="display:flex;align-items:center;gap:4px"><b class="'+(t.pnl>0?'up':t.pnl<0?'dn':'')+'">'+money(t.pnl,{sign:true})+'</b><button class="icon-btn" data-act="del-trade" data-id="'+esc(t.id)+'" aria-label="Delete trade">'+ic('trash')+'</button></span></div>').join(''):'<div class="empty"><b>Nothing here</b>'+(calSel>tk?'This day has not happened yet.':'No trades on this day.')+'</div>')+
