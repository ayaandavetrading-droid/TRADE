<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>DayLock</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap">
<style>
/* Layout: dark teal glass world. Frosted sidebar + top bar, one big frosted-light work panel, glass cards inside.
   Bottom tab bar replaces the sidebar on phones. Single committed look (video reference), set explicitly. */
:root{
  --deep:#05212f; --teal:#0b6f8a; --sky:#25b6f0; --blue:#1590f0; --orange:#ff6a1a;
  --good:#12b886; --good-ink:#0a7a5a; --bad:#e8553f; --bad-ink:#b83a27;
  --ink:#0a1c2e; --ink2:#2a465c; --ink3:#4d6a80;
  --glass-dark:rgba(6,30,44,.58); --glass-dark-line:rgba(255,255,255,.16);
  --panel:linear-gradient(180deg,rgba(255,255,255,.58),rgba(214,238,248,.40));
  --card:rgba(255,255,255,.55); --card-line:rgba(255,255,255,.75); --card-strong:rgba(255,255,255,.82);
  --on-dark:#eaf6fb; --on-dark2:rgba(234,246,251,.68);
  --f-body:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  --f-display:'Oswald','Arial Narrow',Impact,sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{min-height:100%}
body{
  font-family:var(--f-body); font-size:14px; line-height:1.45; color:var(--ink);
  background-color:#072a3a;
  background-image:
    radial-gradient(1100px 650px at 82% 4%,rgba(46,190,220,.55),transparent 62%),
    radial-gradient(900px 700px at 4% 92%,rgba(20,120,180,.55),transparent 60%),
    linear-gradient(160deg,#05212f 0%,#0a4a63 45%,#0b6f8a 75%,#07354a 100%);
  background-attachment:fixed;
  padding-block:0;
  padding-left:max(14px,env(safe-area-inset-left,0px)); padding-right:max(14px,env(safe-area-inset-right,0px));
  font-variant-numeric:tabular-nums;
}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--orange);outline-offset:2px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
svg.i{width:1em;height:1em;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;flex:none}

.app{display:grid;grid-template-columns:236px minmax(0,1fr);gap:16px;max-width:1380px;margin:0 auto;padding-block:16px}
.side{position:sticky;top:16px;align-self:start;height:calc(100vh - 32px);min-height:560px;display:flex;flex-direction:column;gap:6px;padding:16px 12px;border-radius:26px;background:var(--glass-dark);border:1px solid var(--glass-dark-line);backdrop-filter:blur(22px) saturate(1.4);-webkit-backdrop-filter:blur(22px) saturate(1.4);color:var(--on-dark);box-shadow:0 20px 50px rgba(0,20,40,.35)}
.brand{display:flex;align-items:center;gap:10px;padding:2px 6px 14px}
.logo{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;font-size:19px;background:linear-gradient(145deg,rgba(255,255,255,.22),rgba(255,255,255,.06));border:1px solid rgba(255,255,255,.3);color:#fff}
.brand b{display:block;font-family:var(--f-display);font-weight:600;font-size:22px;letter-spacing:.02em;line-height:1}
.brand b i{font-style:normal;color:var(--orange)}
.brand small{display:block;color:var(--on-dark2);font-size:11px;margin-top:3px}
.navlabel{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--on-dark2);padding:10px 10px 4px}
.nav a{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:12px;color:var(--on-dark);text-decoration:none;font-weight:500;font-size:13px;border:1px solid transparent}
.nav a:hover{background:rgba(255,255,255,.08)}
.nav a[aria-current="page"]{background:linear-gradient(180deg,#1ea1ff,#0f7fe0);border-color:rgba(255,255,255,.35);box-shadow:0 6px 18px rgba(21,144,240,.45);color:#fff}
.nav a .i{font-size:16px}
.nav .badge{margin-left:auto;font-size:10px;font-weight:700;min-width:18px;height:18px;padding:0 5px;border-radius:99px;display:grid;place-items:center;background:rgba(255,255,255,.2)}
.side-foot{margin-top:auto;padding:12px;border-radius:16px;background:rgba(255,255,255,.07);border:1px solid var(--glass-dark-line)}
.side-foot .row{display:flex;justify-content:space-between;font-size:11px;color:var(--on-dark2)}
.side-foot .row b{color:#fff;font-weight:600}
.bar{height:6px;border-radius:9px;background:rgba(255,255,255,.18);overflow:hidden;margin-top:8px}
.bar>i{display:block;height:100%;border-radius:9px;background:linear-gradient(90deg,#25b6f0,#5ee0ff)}
.bar.dark{background:rgba(10,28,46,.14)}
.bar.dark>i{background:linear-gradient(90deg,#1590f0,#25b6f0)}
.bar.dark>i.hit{background:linear-gradient(90deg,#0fa578,#35d6a1)}

.col{min-width:0;display:flex;flex-direction:column;gap:14px}
.top{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:20px;background:var(--glass-dark);border:1px solid var(--glass-dark-line);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);color:var(--on-dark)}
.top .brand-m{display:none}
.search{flex:1;min-width:0;display:flex;align-items:center;gap:8px;padding:0 12px;height:38px;border-radius:12px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12)}
.search input{flex:1;min-width:0;background:none;border:0;outline:0;color:#fff;font-size:13px}
.search input::placeholder{color:var(--on-dark2)}
.search:focus-within{border-color:rgba(255,255,255,.4)}
.chip{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 11px;border-radius:99px;font-size:12px;font-weight:600;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.14);white-space:nowrap}
.chip .dot{width:7px;height:7px;border-radius:50%;background:#7ad9ff}
.chip.ok .dot{background:#35d6a1}.chip.err .dot{background:var(--orange)}
.me{display:flex;align-items:center;gap:9px;white-space:nowrap}
.avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:12px;background:linear-gradient(145deg,#25b6f0,#0b6f8a);border:1px solid rgba(255,255,255,.5);color:#fff}
.me b{display:block;font-size:12px;line-height:1.1}.me small{font-size:10px;color:var(--on-dark2)}

.panel{min-width:0;border-radius:28px;padding:22px;background:var(--panel);border:1px solid rgba(255,255,255,.6);backdrop-filter:blur(26px) saturate(1.3);-webkit-backdrop-filter:blur(26px) saturate(1.3);box-shadow:0 24px 60px rgba(0,25,45,.35), inset 0 1px 0 rgba(255,255,255,.7);display:flex;flex-direction:column;gap:16px}
.head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap}
.head h1{margin:0;font-size:22px;font-weight:600;letter-spacing:-.01em;text-wrap:balance}
.head p{margin:3px 0 0;color:var(--ink2);font-size:13px}
.acts{display:flex;gap:8px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:38px;padding:0 15px;border-radius:12px;font-weight:600;font-size:13px;border:1px solid rgba(255,255,255,.8);background:rgba(255,255,255,.55);color:var(--ink);white-space:nowrap}
.btn:hover{background:rgba(255,255,255,.8)}
.btn.dark{background:#0a1c2e;color:#fff;border-color:#0a1c2e}
.btn.dark:hover{background:#13304a}
.btn.orange{background:var(--orange);border-color:var(--orange);color:#fff}
.btn.sm{height:30px;padding:0 11px;font-size:12px;border-radius:10px}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.danger{color:var(--bad-ink)}

.card{background:var(--card);border:1px solid var(--card-line);border-radius:20px;padding:16px;min-width:0;box-shadow:0 8px 24px rgba(0,40,70,.08)}
.card h2{margin:0;font-size:14px;font-weight:600}
.card .sub{color:var(--ink3);font-size:12px;margin-top:2px}
.card-h{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:10px}
.grid{display:grid;gap:12px}
.g-hero{grid-template-columns:minmax(0,1.5fr) minmax(0,1fr)}
.g-tiles{grid-template-columns:repeat(auto-fit,minmax(138px,1fr))}
.g-two{grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);align-items:start}
.g-cal{grid-template-columns:minmax(0,1.7fr) minmax(280px,1fr)}
.g-goals{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.tile{display:flex;flex-direction:column;gap:2px}
.tile .ico{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;background:rgba(255,255,255,.7);border:1px solid #fff;font-size:16px;color:var(--ink2);margin-bottom:8px}
.tile .big{font-size:26px;font-weight:700;letter-spacing:-.02em;line-height:1.1}
.tile .lab{font-size:12px;color:var(--ink2);font-weight:500}
.tile .note{font-size:11px;color:var(--ink3)}
.up{color:var(--good-ink)}.dn{color:var(--bad-ink)}
.pill{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;padding:3px 9px;border-radius:99px;background:rgba(255,255,255,.7);border:1px solid #fff}
.pill.good{background:rgba(18,184,134,.18);color:var(--good-ink);border-color:rgba(18,184,134,.35)}
.pill.bad{background:rgba(232,85,63,.16);color:var(--bad-ink);border-color:rgba(232,85,63,.35)}
.pill.blue{background:rgba(21,144,240,.16);color:#0b62ad;border-color:rgba(21,144,240,.35)}

/* lock banner */
.lock{display:flex;align-items:center;gap:20px;flex-wrap:wrap;padding:20px 22px;border-radius:22px;color:#fff;background:linear-gradient(135deg,#0a1c2e 0%,#0f4b6b 60%,#0b7aa0 100%);border:1px solid rgba(255,255,255,.3);box-shadow:0 16px 40px rgba(5,30,50,.4)}
.lock .seal{width:64px;height:64px;border-radius:20px;display:grid;place-items:center;font-size:30px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.35)}
.lock h2{margin:0;font-family:var(--f-display);font-weight:600;font-size:34px;line-height:1.05;letter-spacing:.015em;text-transform:uppercase}
.lock h2 i{font-style:normal;color:var(--orange)}
.lock p{margin:4px 0 0;color:var(--on-dark2);font-size:13px}
.lock .cd{margin-left:auto;text-align:right}
.lock .cd small{display:block;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--on-dark2)}
.lock .cd b{font-family:var(--f-display);font-weight:500;font-size:34px;letter-spacing:.04em}
.lock .reopen{flex-basis:100%;display:flex;gap:8px;flex-wrap:wrap;align-items:center;font-size:12px;color:var(--on-dark2)}
.lock .reopen input{height:32px;border-radius:9px;border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.1);padding:0 10px;color:#fff;width:130px}

/* ring */
.ringwrap{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.ring{position:relative;width:150px;height:150px;flex:none}
.ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.ring .mid{position:absolute;inset:0;display:grid;place-content:center;text-align:center}
.ring .mid b{font-size:28px;font-weight:700;letter-spacing:-.02em;line-height:1}
.ring .mid small{font-size:11px;color:var(--ink3)}
.kv{flex:1;min-width:150px;display:grid;gap:8px}
.kv div{display:flex;justify-content:space-between;gap:10px;font-size:13px;border-bottom:1px dashed rgba(10,28,46,.14);padding-bottom:7px}
.kv div span{color:var(--ink2)}.kv div b{font-weight:600}
.chart{width:100%;height:auto;display:block}
.chart text{font-family:var(--f-body);font-size:13px;fill:var(--ink3)}
.chart .tgt{font-weight:600;fill:var(--orange)}

/* tables */
.tbl{width:100%;border-collapse:collapse;font-size:13px}
.tbl th{text-align:left;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink3);font-weight:600;padding:6px 8px;white-space:nowrap}
.tbl td{padding:9px 8px;border-top:1px solid rgba(10,28,46,.09);white-space:nowrap}
.tbl td.wrap{white-space:normal;min-width:120px;color:var(--ink2)}
.tbl tr:hover td{background:rgba(255,255,255,.35)}
.num{text-align:right}
.scroll{overflow-x:auto}
.empty{padding:22px 10px;text-align:center;color:var(--ink3)}
.empty b{display:block;color:var(--ink);font-size:14px;margin-bottom:2px}
.side-tag{font-size:11px;font-weight:700;padding:2px 8px;border-radius:7px}
.side-tag.buy{background:rgba(21,144,240,.16);color:#0b62ad}.side-tag.sell{background:rgba(255,106,26,.16);color:#b24a0b}
.icon-btn{width:30px;height:30px;border-radius:9px;border:1px solid transparent;background:none;color:var(--ink3);display:inline-grid;place-items:center}
.icon-btn:hover{background:rgba(255,255,255,.7);color:var(--bad-ink)}
.icon-btn.armed{background:var(--bad);color:#fff;width:auto;padding:0 9px;font-size:11px;font-weight:700}

/* checklist */
.checks{display:grid;gap:7px;margin:0;padding:0;list-style:none}
.checks label{display:flex;gap:10px;align-items:center;padding:9px 10px;border-radius:12px;background:rgba(255,255,255,.5);border:1px solid rgba(255,255,255,.8);cursor:pointer;font-size:13px}
.checks input{appearance:none;width:18px;height:18px;border-radius:6px;border:1.6px solid var(--ink3);background:#fff;display:grid;place-items:center;flex:none;margin:0}
.checks input:checked{background:var(--blue);border-color:var(--blue)}
.checks input:checked::after{content:"";width:9px;height:5px;border-left:2px solid #fff;border-bottom:2px solid #fff;transform:rotate(-45deg) translate(1px,-1px)}
.checks input:checked+span{color:var(--ink3);text-decoration:line-through}

/* forms */
.f{display:grid;gap:6px;font-size:12px;font-weight:600;color:var(--ink2)}
.f input,.f select,.f textarea{width:100%;min-width:0;height:38px;padding:0 11px;border-radius:11px;border:1px solid rgba(10,28,46,.18);background:rgba(255,255,255,.85);font-weight:500;color:var(--ink);font-size:14px}
.f textarea{height:auto;min-height:70px;padding:9px 11px;resize:vertical}
.f input:focus,.f select:focus,.f textarea:focus{outline:2px solid var(--blue);outline-offset:0;border-color:var(--blue)}
.f small{font-weight:400;color:var(--ink3);font-size:11px}
.fg{display:grid;gap:12px;grid-template-columns:repeat(2,minmax(0,1fr))}
.fg .span2{grid-column:1/-1}
.seg{display:inline-grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:3px;padding:3px;border-radius:12px;background:rgba(10,28,46,.1)}
.seg label{position:relative}
.seg input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
.seg span{display:grid;place-items:center;height:32px;padding:0 12px;border-radius:9px;font-size:13px;font-weight:600;color:var(--ink2)}
.seg input:checked+span{background:#fff;color:var(--ink);box-shadow:0 2px 8px rgba(0,40,70,.18)}
.seg input:focus-visible+span{outline:2px solid var(--orange)}
.seg.win input[value=win]:checked+span{background:var(--good);color:#fff}
.seg.win input[value=loss]:checked+span{background:var(--bad);color:#fff}
.seg.win input[value=be]:checked+span{background:#6b8396;color:#fff}
.rule-row{display:flex;gap:8px;margin-bottom:8px}
.rule-row input{flex:1}
.calc-out{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:12px}
.calc-out div{padding:10px;border-radius:12px;background:rgba(255,255,255,.6);border:1px solid #fff}
.calc-out small{display:block;color:var(--ink3);font-size:11px}
.calc-out b{font-size:17px}

/* calendar */
.cal-head{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.cal-head h2{font-size:18px;margin:0 6px 0 0;font-weight:600}
.dow,.cells{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px}
.dow span{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink3);font-weight:600;text-align:center;padding:4px 0}
.cell{position:relative;min-height:74px;padding:7px 8px;border-radius:14px;border:1px solid rgba(255,255,255,.8);background:rgba(255,255,255,.4);text-align:left;display:flex;flex-direction:column;justify-content:space-between;gap:4px;color:var(--ink);min-width:0}
.cell .d{font-size:12px;font-weight:600;color:var(--ink2)}
.cell .p{font-size:13px;font-weight:700;white-space:nowrap}
.cell .t{font-size:10px;color:var(--ink3)}
.cell.out{opacity:.35}
.cell.fut{opacity:.55}
.cell.hit{background:linear-gradient(160deg,#27c79a,#0f9a75);border-color:#0f9a75;color:#fff}
.cell.hit .d,.cell.hit .t,.cell.hit .p{color:#fff}
.cell.win{background:rgba(18,184,134,.2);border-color:rgba(18,184,134,.4)}
.cell.loss{background:rgba(232,85,63,.18);border-color:rgba(232,85,63,.4)}
.cell.win .p{color:var(--good-ink)}.cell.loss .p{color:var(--bad-ink)}
.cell.today{box-shadow:0 0 0 2px var(--orange)}
.cell.sel{outline:2px solid var(--blue);outline-offset:1px}
.cell .ck{position:absolute;top:7px;right:7px;font-size:13px}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:11.5px;color:var(--ink2)}
.legend i{display:inline-block;width:11px;height:11px;border-radius:4px;margin-right:6px;vertical-align:-1px}

/* modal + toast */
.overlay{position:fixed;inset:0;z-index:50;display:grid;place-items:center;padding:16px;background:rgba(3,18,30,.6);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.sheet{width:min(560px,100%);max-height:calc(100% - 8px);overflow:auto;border-radius:24px;padding:20px;background:rgba(236,247,252,.96);border:1px solid #fff;box-shadow:0 30px 80px rgba(0,15,30,.5);display:grid;gap:14px}
.sheet h2{margin:0;font-size:18px;font-weight:600}
.sheet .hd{display:flex;justify-content:space-between;align-items:center}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);z-index:60;background:#0a1c2e;color:#fff;padding:10px 16px;border-radius:99px;font-weight:600;font-size:13px;box-shadow:0 10px 30px rgba(0,0,0,.4);max-width:calc(100vw - 32px)}
.demo{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:10px 14px;border-radius:14px;background:rgba(255,106,26,.16);border:1px solid rgba(255,106,26,.45);font-size:13px;color:#7a3205}
.demo b{color:#5c2403}
.small{font-size:12px;color:var(--ink3)}
.list-row{display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-top:1px solid rgba(10,28,46,.09);font-size:13px}
.list-row:first-child{border-top:0}
.tabbar{display:none}

@media (max-width:980px){
  .g-hero,.g-two,.g-cal{grid-template-columns:minmax(0,1fr)}
}
@media (max-width:860px){
  .app{grid-template-columns:minmax(0,1fr);padding-bottom:84px}
  .side{position:fixed;left:0;right:0;bottom:0;top:auto;z-index:40;height:auto;min-height:0;flex-direction:row;padding:6px max(8px,env(safe-area-inset-left,0px)) calc(6px + env(safe-area-inset-bottom,0px));border-radius:20px 20px 0 0;border-bottom:0}
  .side .brand,.side .navlabel,.side-foot{display:none}
  .side .nav{display:flex;flex:1;gap:2px;justify-content:space-between}
  .nav a{flex:1;flex-direction:column;gap:3px;padding:7px 2px;font-size:10.5px;text-align:center;min-width:0}
  .nav a .i{font-size:18px}
  .nav .badge{position:absolute;margin:0;transform:translate(14px,-12px)}
  .nav a{position:relative}
  .top .brand-m{display:flex}
  .top .brand-m .logo{width:34px;height:34px;font-size:16px}
  .top .brand-m b{font-family:var(--f-display);font-weight:600;font-size:19px}
  .top .brand-m b i{font-style:normal;color:var(--orange)}
  .me div,.top .hide-m{display:none}
  .panel{padding:14px;border-radius:22px}
}
@media (max-width:560px){
  .cell{min-height:58px;padding:5px 5px}
  .cell .t{display:none}
  .cell .p{font-size:11px}
  .cell .ck{display:none}
  .dow,.cells{gap:4px}
  .fg{grid-template-columns:minmax(0,1fr)}
  .lock h2{font-size:26px}.lock .cd{margin-left:0;text-align:left}
  .head h1{font-size:19px}
