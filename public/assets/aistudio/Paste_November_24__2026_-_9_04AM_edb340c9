  if(VIEW==='today')updateCalc();
  tickCd()}
function tickCd(){const el=$('#cd');if(!el)return;const n=new Date();const m=new Date(n.getFullYear(),n.getMonth(),n.getDate()+1);const s=Math.max(0,Math.floor((m-n)/1000));
  el.textContent=pad(Math.floor(s/3600))+':'+pad(Math.floor(s%3600/60))+':'+pad(s%60)}

let toastT=null;function toast(m){const t=$('#toast');t.textContent=m;t.hidden=false;clearTimeout(toastT);toastT=setTimeout(()=>{t.hidden=true},2600)}

/* ---------- trade modal ---------- */
function openTrade(date){
  const tk=todayKey();date=date||tk;const now=new Date();
  $('#modal').hidden=false;
  $('#modal').innerHTML='<form class="sheet" id="tradeForm" autocomplete="off" role="dialog" aria-modal="true" aria-label="Log a trade"><div class="hd"><h2>Log a trade</h2><button class="icon-btn" type="button" data-act="close-modal" aria-label="Close">'+ic('x')+'</button></div>'+
  '<div class="fg"><label class="f">Symbol<input name="symbol" list="syms" value="'+esc(localStorage.getItem('daylock.sym')||'XAUUSD')+'" required><datalist id="syms">'+SYMBOLS.map(s=>'<option value="'+s+'">').join('')+'</datalist></label>'+
  '<div class="f">Side<div class="seg"><label><input type="radio" name="side" value="Buy" checked><span>Buy</span></label><label><input type="radio" name="side" value="Sell"><span>Sell</span></label></div></div>'+
  '<div class="f span2">Result<div class="seg win"><label><input type="radio" name="result" value="win" checked><span>Win</span></label><label><input type="radio" name="result" value="loss"><span>Loss</span></label><label><input type="radio" name="result" value="be"><span>Break-even</span></label></div></div>'+
  '<label class="f span2">Amount ('+esc(cur())+')<input name="amount" type="number" inputmode="decimal" step="0.01" min="0" placeholder="0.00" required><small>Enter the size of the win or loss. Pick Win or Loss above.</small></label>'+
  '<label class="f">Lot size<input name="lots" type="number" inputmode="decimal" step="0.01" min="0" placeholder="0.10"></label><label class="f">Setup<select name="setup">'+SETUPS.map(s=>'<option>'+s+'</option>').join('')+'</select></label>'+
  '<label class="f">Entry price<input name="entry" type="number" inputmode="decimal" step="any"></label><label class="f">Exit price<input name="exit" type="number" inputmode="decimal" step="any"></label>'+
  '<label class="f">Date<input name="date" type="date" value="'+date+'" max="'+tk+'" required></label><label class="f">Time<input name="time" type="time" value="'+pad(now.getHours())+':'+pad(now.getMinutes())+'"></label>'+
  '<label class="f span2">Note<textarea name="note" placeholder="Why did you take it?"></textarea></label></div>'+
  '<div class="acts" style="justify-content:flex-end"><button class="btn" type="button" data-act="close-modal">Cancel</button><button class="btn dark" type="submit">'+ic('check')+' Save trade</button></div></form>';
  setTimeout(()=>{const a=$('#tradeForm [name=amount]');if(a)a.focus()},30)}
function closeModal(){const m=$('#modal');m.hidden=true;m.innerHTML=''}
function saveTrade(f){
  const fd=new FormData(f);const tk=todayKey();const date=fd.get('date')||tk;const res=fd.get('result');let amt=Math.abs(parseFloat(fd.get('amount'))||0);
  if(res!=='be'&&amt<=0){toast('Enter the win or loss amount');return}
  if(date>tk){toast('That date is in the future');return}
  if(date===tk&&status(tk).locked){toast('Today is locked. Come back tomorrow.');closeModal();return}
  const num=k=>{const v=parseFloat(fd.get(k));return isFinite(v)?v:null};
  const sym=String(fd.get('symbol')||'').trim().toUpperCase()||'TRADE';try{localStorage.setItem('daylock.sym',sym)}catch(e){}
  ensureDay(date);
  S.trades.push({id:uid(),date,time:fd.get('time')||'',symbol:sym,side:fd.get('side'),lots:num('lots'),entry:num('entry'),exit:num('exit'),pnl:res==='win'?r2(amt):res==='loss'?-r2(amt):0,setup:fd.get('setup'),note:String(fd.get('note')||'').trim()});
  touch([date.slice(0,7)]);closeModal();render();
  if(date===tk){const st=status(tk);toast(st.state==='target'?'Target hit. Day locked.':st.state==='stop'?'Max loss reached. Day locked.':st.state==='limit'?'Trade limit reached. Day locked.':'Trade saved')}else toast('Trade saved')}

/* ---------- export ---------- */
async function exportCsv(){
  const h=['date','time','symbol','side','lots','entry','exit','pnl','setup','note'];const q=v=>'"'+String(v==null?'':v).replace(/"/g,'""')+'"';
  const csv=[h.join(',')].concat(S.trades.slice().sort((a,b)=>a.date<b.date?-1:1).map(t=>h.map(k=>q(t[k])).join(','))).join('\n');
  try{const dl=await window.claude.use('downloads');if(!dl)throw 0;await dl.save({filename:'daylock-trades.csv',data:csv});toast('CSV ready')}
  catch(e){try{await navigator.clipboard.writeText(csv);toast('CSV copied to clipboard')}catch(e2){toast('Export is not available here')}}}

/* ---------- events ---------- */
const armed={};
document.addEventListener('click',async e=>{
  const b=e.target.closest('[data-act]');if(!b)return;const a=b.dataset.act;const tk=todayKey();
  if(a==='open-trade'){openTrade(b.dataset.date)}
  else if(a==='close-modal'){closeModal()}
  else if(a==='del-trade'){const id=b.dataset.id;if(armed[id]){const t=S.trades.find(x=>x.id===id);S.trades=S.trades.filter(x=>x.id!==id);delete armed[id];if(t)touch([t.date.slice(0,7)]);render();toast('Trade deleted')}
    else{armed[id]=1;b.classList.add('armed');b.textContent='Delete?';setTimeout(()=>{delete armed[id];if(b.isConnected){b.classList.remove('armed');b.innerHTML=ic('trash')}},2800)}}
  else if(a==='close-day'){ensureDay(tk).closed=true;touch();render();toast('Day closed. See you tomorrow.')}
  else if(a==='reopen'){const v=($('#reopenIn')||{}).value||'';if(v.trim().toUpperCase()==='REOPEN'){const d=ensureDay(tk);d.reopened=true;delete d.closed;touch();render();toast('Day unlocked')}else toast('Type REOPEN to confirm')}
  else if(a==='cal-prev'||a==='cal-next'){const [y,m]=calMonth.split('-').map(Number);const d=new Date(y,m-1+(a==='cal-next'?1:-1),1);calMonth=d.getFullYear()+'-'+pad(d.getMonth()+1);render()}
  else if(a==='cal-today'){calMonth=tk.slice(0,7);calSel=tk;render()}
  else if(a==='cal-sel'){calSel=b.dataset.k;render()}
  else if(a==='add-rule'){const w=document.createElement('div');w.innerHTML=ruleRow('');$('#rules').appendChild(w.firstChild);const i=$$('.rule-in');i[i.length-1].focus()}
  else if(a==='del-rule'){b.closest('.rule-row').remove()}
  else if(a==='clear-demo'){const ms=[...new Set(S.trades.map(t=>t.date.slice(0,7)))];S.trades=[];S.days={};S.checks={};S.demo=false;touch(ms);render();toast('Sample data cleared. Ready for real trades.')}
  else if(a==='wipe'){if(armed.wipe){const ms=[...new Set(S.trades.map(t=>t.date.slice(0,7)))];S.trades=[];S.days={};S.checks={};S.demo=false;delete armed.wipe;touch(ms);render();toast('All trades erased')}else{armed.wipe=1;b.textContent='Click again to erase everything';setTimeout(()=>{delete armed.wipe;if(b.isConnected)b.textContent='Erase all trades'},3500)}}
  else if(a==='export'){exportCsv()}
});
document.addEventListener('change',e=>{const t=e.target;
  if(t.matches('[data-act=check]')){const tk=todayKey();const i=+t.dataset.i;const c=S.checks[tk]||[];const n=t.checked?c.concat(c.indexOf(i)<0?[i]:[]):c.filter(x=>x!==i);S.checks={};S.checks[tk]=n;touch();const el=$('#chkSub');if(el)el.textContent=n.length+' of '+(S.settings.rules||[]).length+' ready'}
  else if(t.id==='fM'||t.id==='fR'){tf.m=$('#fM').value;tf.r=$('#fR').value;$('#tbl').innerHTML=tradesTable()}
  else if(t.id==='dayNote'){const k=t.dataset.k;const d=S.days[k]||(S.days[k]={});d.note=t.value.trim();touch();toast('Note saved')}
});
document.addEventListener('input',e=>{const t=e.target;
  if(t.id==='fQ'){tf.q=t.value;$('#tbl').innerHTML=tradesTable()}
  else if(t.closest&&t.closest('#calc'))updateCalc()});
document.addEventListener('submit',e=>{e.preventDefault();const f=e.target;
  if(f.id==='tradeForm')saveTrade(f);
  else if(f.id==='goalForm'){
    const fd=new FormData(f);const s=S.settings;const n=(k,d)=>{const v=parseFloat(fd.get(k));return isFinite(v)&&v>=0?v:d};
    s.unit=fd.get('unit')==='pct'?'pct':'amount';s.target=n('target',s.target);s.stop=n('stop',s.stop);s.maxTrades=Math.floor(n('maxTrades',s.maxTrades));s.riskPct=n('riskPct',s.riskPct);
    s.currency=(fd.get('currency')||'$').trim()||'$';s.balance=n('balance',s.balance);s.pipValue=n('pipValue',s.pipValue);s.weekGoal=n('weekGoal',s.weekGoal);s.monthGoal=n('monthGoal',s.monthGoal);
    s.rules=$$('.rule-in',f).map(i=>i.value.trim()).filter(Boolean);s.why=String(fd.get('why')||'').trim();
    const tk=todayKey();const d=S.days[tk];if(d&&d.target!=null){delete d.target;delete d.stop;if(S.trades.some(t=>t.date===tk))ensureDay(tk)}
    touch();render();toast('Goals updated')}});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('#modal').hidden)closeModal()});
$('#modal').addEventListener('mousedown',e=>{if(e.target.id==='modal')closeModal()});
$('#q').addEventListener('keydown',e=>{if(e.key==='Enter'){tf={m:'all',r:'all',q:e.target.value};if(location.hash==='#trades')render();else location.hash='#trades'}});
window.addEventListener('hashchange',()=>{render();window.scrollTo(0,0)});
setInterval(()=>{if(todayKey()!==renderedDay){render();return}tickCd()},1000);

/* ---------- boot ---------- */
S=(function(){const l=loadLocal();return l?normalize(l):null})();
if(!S){makeDemo()}
$('#logoI').innerHTML=ic('lock');$('#logoM').innerHTML=ic('lock');$('#searchI').innerHTML=ic('search');
setSync('local');render();initDb();
})();
</script>

