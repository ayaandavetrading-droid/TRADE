function updateCalc(){const box=$('#calc .calc-out');if(!box)return;const bal=Number(box.dataset.bal)||0;
  const rp=parseFloat($('#cRisk').value)||0,sl=parseFloat($('#cSl').value)||0,pv=parseFloat($('#cPv').value)||0,rr=parseFloat($('#cRr').value)||0;
  const risk=bal*rp/100;const lots=sl>0&&pv>0?risk/(sl*pv):0;
  $('#oRisk').textContent=money(risk);$('#oLots').textContent=lots?(Math.floor(lots*100)/100).toFixed(2):'--';$('#oTp').textContent=sl&&rr?(sl*rr).toFixed(1):'--';$('#oPnl').textContent=money(risk*rr)}

function viewCalendar(){
